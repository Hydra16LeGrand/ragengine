# ============ RAGEngine — PRODUCTION environment template ============
#
# VERSIONED TEMPLATE: never put a real value in this file. Placeholders only.
#
#   bash scripts/init-prod-env.sh   # copies this file to .env.prod.local (git-ignored),
#                                   # generates every missing secret, never prints them
#   bash scripts/start-prod.sh      # starts the production stack from .env.prod.local
#
# Only what differs from the development defaults lives here; every other variable
# keeps the default documented in .env.example (copy it here if you need to change it).
# Production runs as separate Compose projects, volumes, network and host ports, so a
# development stack can run on the same machine without collision.

RAGENGINE_ENV_FILE=.env.prod
RAGENGINE_ENV=production
RAGENGINE_PROJECT_NAME=ragengine-prod
RAGFLOW_PROJECT_NAME=ragflow-prod

# Image tag: never the floating `dev` tag in production. scripts/deploy-prod.sh pins
# the reproducible tag printed by scripts/build-images.sh (short git SHA).
RAGENGINE_IMAGE_TAG=change-me

# --- Public origin ---
# Same-origin deployment: the frontend and /api are served by Traefik on one host name.
# Replace rag.example.com with your own host name.
RAGENGINE_CORS_ORIGINS=https://rag.example.com
# Session cookies are Secure (and __Host- prefixed) automatically in production.

# --- Host ports, all bound to 127.0.0.1 (distinct from the development defaults) ---
RAGENGINE_API_BIND_ADDRESS=127.0.0.1
RAGENGINE_API_PORT=8001
RAGENGINE_POSTGRES_HOST_PORT=5434
RAGENGINE_REDIS_HOST_PORT=6381
RAGENGINE_RAGFLOW_HOST_PORT=9391
RAGENGINE_RAGFLOW_WEB_HOST_PORT=9481
RAGENGINE_INFERENCE_EMBEDDING_HOST_PORT=9995
RAGENGINE_INFERENCE_RERANKER_HOST_PORT=9996
RAGENGINE_TRAEFIK_BIND_ADDRESS=127.0.0.1
RAGENGINE_TRAEFIK_HOST_PORT=8090

# --- Secrets: generated by scripts/init-prod-env.sh when empty or `change-me` ---
RAGENGINE_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
RAGFLOW_BOOTSTRAP_EMAIL=service@ragengine.local
RAGFLOW_BOOTSTRAP_PASSWORD=change-me
RAGFLOW_MYSQL_PASSWORD=change-me
RAGFLOW_MINIO_PASSWORD=change-me
RAGFLOW_ELASTIC_PASSWORD=change-me
RAGFLOW_REDIS_PASSWORD=change-me
# Issued by scripts/bootstrap_ragflow.py on first start (written by start-prod.sh).
RAGFLOW_API_KEY=

# --- External LLM providers: at least one, for the Playground and evaluations ---
# Set a monthly spending cap in each provider console before exposing a public demo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Optional public exposure through Cloudflare Tunnel (profile `tunnel`) ---
# Leave empty to expose Traefik through your own reverse proxy instead.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Logs: tighter rotation than development ---
RAGENGINE_LOG_MAX_SIZE=10m
RAGENGINE_LOG_MAX_FILE=3
